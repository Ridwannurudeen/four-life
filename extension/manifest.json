{
  "manifest_version": 3,
  "name": "FOUR-LIFE Certified",
  "version": "1.3.1",
  "description": "Trust-grade every Four.meme token on BNB Chain. Works on four.meme, BscScan, PancakeSwap, and DEXScreener. Watchlist + Chrome notifications on tier transitions. Deterministic rule trace, on-chain attestation.",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://four.meme/*",
    "https://bscscan.com/*",
    "https://pancakeswap.finance/*",
    "https://dexscreener.com/*",
    "https://api.dexscreener.com/*",
    "https://four-life.gudman.xyz/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://four.meme/*",
        "https://bscscan.com/token/*",
        "https://pancakeswap.finance/info/*",
        "https://pancakeswap.finance/swap*",
        "https://dexscreener.com/bsc/*"
      ],
      "js": ["content/inject.js", "content/overlay.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FOUR-LIFE Certified"
  },
  "web_accessible_resources": [
    {
      "resources": ["onboarding/onboarding.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
