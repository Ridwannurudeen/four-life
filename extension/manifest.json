{
  "manifest_version": 3,
  "name": "FOUR-LIFE Certified",
  "version": "1.0.0",
  "description": "Shows the FOUR-LIFE Certified trust badge and deterministic risk snapshot on every four.meme token page.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://four.meme/*",
    "https://four-life.gudman.xyz/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://four.meme/*"],
      "js": ["content/inject.js", "content/overlay.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FOUR-LIFE Certified"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
